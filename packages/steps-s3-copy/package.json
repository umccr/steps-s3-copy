{
  "name": "@umccr/steps-s3-copy",
  "version": "0.0.0",
  "description": "CDK construct for an AWS Steps machine that copies S3 objects",
  "homepage": "https://github.com/umccr/steps-s3-copy",
  "license": "MIT",
  "author": {
    "name": "University of Melbourne Centre for Cancer Research",
    "organization": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umccr/steps-s3-copy.git"
  },
  "main": "out/steps-s3-copy-construct.js",
  "types": "out/steps-s3-copy-construct.d.ts",
  "scripts": {
    "build": "jsii",
    "build:watch": "jsii -w",
    "package": "jsii-pacmak"
  },
  "keywords": [
    "jsii",
    "cdk",
    "s3",
    "steps",
    "copy"
  ],
  "jsii": {
    "outdir": "dist",
    "targets": {},
    "tsc": {
      "outDir": "out",
      "rootDir": "src",
      "types": [
        "node"
      ]
    }
  },
  "peerDependencies": {
    "aws-cdk-lib": "^2.215.0",
    "constructs": "^10.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1035.0",
    "@aws-sdk/client-secrets-manager": "^3.1035.0",
    "@aws-sdk/lib-storage": "^3.1035.0",
    "csv-stringify": "^6.7.0",
    "tmp": "^0.2.5"
  },
  "bundledDependencies": [
    "@aws-sdk/client-s3",
    "@aws-sdk/client-secrets-manager",
    "@aws-sdk/lib-storage",
    "csv-stringify",
    "tmp"
  ],
  "devDependencies": {
    "@types/aws-lambda": "^8.10.161",
    "@types/node": "^22.19.17",
    "@types/tmp": "^0.2.6",
    "aws-cdk-lib": "2.215.0",
    "constructs": "10.0.0",
    "esbuild": "^0.28.0",
    "jsii": "^5.9.37",
    "jsii-pacmak": "^1.128.0",
    "jsii-rosetta": "^5.9.42",
    "publib": "^0.2.1042",
    "tsx": "^4.21.0",
    "typescript": "6.0.3",
    "nodejs-polars": "^0.24.1"
  }
}
